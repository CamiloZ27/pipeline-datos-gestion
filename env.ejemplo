# Copie este archivo a ".env" si desea configurar credenciales opcionales.
# NUNCA suba el archivo ".env" a GitHub (está en .gitignore).

# Token opcional de Socrata (datos.gov.co): la API SODA2 funciona sin token,
# pero tener uno gratis evita límites de tasa en descargas repetidas.
# https://www.datos.gov.co/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Credenciales de PostgreSQL local (Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=matricula_es
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline

# Opcional: token de GitHub para publicación automática desde Airflow
GITHUB_TOKEN=
GITHUB_REPO=
